{
    "name": "@model-w/agent-w",
    "version": "0.11.0",
    "type": "module",
    "main": "./index.js",
    "exports": {
        ".": "./index.js",
        "./package.json": "./package.json"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ModelW/agent-w.git"
    },
    "description": "Agent W - Tools and skills for Model W projects with coding agents",
    "bin": {
        "agent-w": "bin/cli.js"
    },
    "scripts": {
        "test": "npm run test:unit && npm run test:plugin && npm run test:format",
        "test:unit": "node --test test/*.test.js",
        "test:plugin": "claude plugin validate .claude-plugin/plugin.json && claude plugin validate .claude-plugin/marketplace.json",
        "test:format": "prettier --check .",
        "format": "prettier --write ."
    },
    "keywords": [
        "gemini",
        "cli",
        "extension",
        "opencode",
        "plugin",
        "model-w",
        "model-w-bootstrap",
        "agent"
    ],
    "author": "with-madrid.com",
    "license": "WTFPL",
    "opencode": {
        "extensions": [
            "./index.js"
        ]
    },
    "devDependencies": {
        "@opencode-ai/plugin": "^1.4.6",
        "@opencode/plugin": "^2.0.11",
        "prettier": "^3.8.1"
    },
    "files": [
        "index.js",
        "src/",
        "skills/",
        "agents/",
        "bin/"
    ]
}
